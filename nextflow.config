/*
 * phage-assembly-nf — Illumina paired-end phage genome assembly pipeline.
 * Mirrors the steps of phage_genome_homework.html (command-line / Illumina path).
 */

manifest {
    name            = 'phage-assembly-nf'
    description     = 'Raw Illumina FASTQ -> QC -> fastp -> subsample -> Unicycler/SPAdes -> Bandage -> mapping -> variants -> Pilon -> PhageTerm -> rotation'
    version         = '1.1.0'
    nextflowVersion = '>=23.10'
}

params {
    // ---- input / output -------------------------------------------------
    input             = null        // folder with <sample>_R1/_R2 .fastq.gz (Illumina facility names are fine)
    samplesheet       = null        // alternative: CSV with columns sample,fastq_1,fastq_2 (one row per lane)
    outdir            = 'results'

    // ---- read handling -------------------------------------------------
    cap_pairs         = 500000      // never give the assembler more than this many read pairs
    quick_pairs       = 100000      // pairs used for the quick genome-size assembly (only when --genome_size is not given)
    genome_size       = null        // bp; if not given it is estimated from the quick assembly
    coverage          = 200         // target coverage for the main assembly
    fallback_coverage = 100         // used automatically if the main assembly fails
    seed              = 11          // seqtk seed, same for R1 and R2 so pairs stay together
    min_len           = 50          // fastp: drop reads shorter than this after trimming
    cut_mean_quality  = 20          // fastp sliding-window quality
    host_fasta        = null        // optional host genome; reads mapping to it are removed before assembly

    // ---- assembly ------------------------------------------------------
    unicycler_modes   = 'normal,conservative,bold'   // every mode listed is run; set to 'normal' to save time
    run_spades        = true        // also run plain SPAdes --isolate for comparison
    primary           = 'unicycler_normal'           // assembly used for mapping, variants, Pilon, PhageTerm, rotation

    // ---- finishing -----------------------------------------------------
    skip_phageterm    = false
    min_phage_contig  = 10000       // termini analysis, PhageTerm and rotation only look at contigs at least this long; shorter ones are kept unchanged
    phageterm_image   = 'phage-pipeline/phagetermvirome:4.3'   // built locally by run.sh (containers/phageterm/Dockerfile)

    // ---- resources (defaults sized for a 16 GB / 8+ core WSL2 laptop) --
    max_cpus          = 8
    max_memory        = '12.GB'

    help              = false
}

// ---- containers (pinned; quay.io/biocontainers unless noted) --------------
params.containers = [
    fastqc    : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
    multiqc   : 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2',
    fastp     : 'quay.io/biocontainers/fastp:1.4.0--h43da1c4_0',
    seqtk     : 'quay.io/biocontainers/seqtk:1.5--h577a1d6_1',
    seqkit    : 'quay.io/biocontainers/seqkit:2.14.0--hb192632_0',
    unicycler : 'quay.io/biocontainers/unicycler:0.5.1--py312hdcc493e_5',
    spades    : 'quay.io/biocontainers/spades:4.3.0--hde4eca7_2',
    bandage   : 'quay.io/biocontainers/bandage:0.9.0--h9948957_0',
    bwasam    : 'community.wave.seqera.io/library/bwa_htslib_samtools:83b50ff84ead50d0',   // bwa + samtools (nf-core image)
    bcftools  : 'quay.io/biocontainers/bcftools:1.24--h118bc1c_4',
    pilon     : 'quay.io/biocontainers/pilon:1.24--hdfd78af_0',
    dnaapler  : 'quay.io/biocontainers/dnaapler:1.4.0--pyhdfd78af_0',
    igvreports: 'quay.io/biocontainers/igv-reports:1.16.0--pyh7e72e81_0',
]

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Nextflow schedules tasks within these totals: memory is the real limit (one 8 GB assembly at a time on a
// 12 GB budget), while small steps may use any spare cores of the machine
executor {
    cpus   = Math.max(params.max_cpus as int, Runtime.runtime.availableProcessors())
    memory = params.max_memory
}

process {
    cpus   = 2
    memory = 2.GB
    time   = 4.h

    // retry once with more memory when the kernel killed the task (137 = OOM, 140/143 = killed)
    errorStrategy = { task.exitStatus in [137, 140, 143, 104, 134] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low    { cpus = 2; memory = 2.GB }
    withLabel: process_medium { cpus = 4; memory = 4.GB }
    withLabel: process_high   { cpus = { params.max_cpus }; memory = { task.attempt == 1 ? 8.GB : 11.GB } }
    withLabel: optional_step  { errorStrategy = 'ignore' }   // PhageTerm: a failure is reported but never stops the run
}

profiles {
    test {
        params.input       = "${projectDir}/test_data"
        params.outdir      = "${projectDir}/test_data/results_test"
        params.coverage    = 200
    }
    quick {   // one assembler only, for teaching demos
        params.unicycler_modes = 'normal'
        params.run_spades      = false
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true
           fields  = 'task_id,hash,name,status,exit,attempt,realtime,peak_rss,workdir,error_action' }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
